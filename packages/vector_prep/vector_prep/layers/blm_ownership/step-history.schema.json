{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riverscapes.net/schemas/vector_prep/blm_ownership/step-history.schema.json",
  "title": "BLM Ownership Step History",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "version",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string",
      "const": "blm_ownership"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/historyEntry"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "errorSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "step_id",
        "status",
        "execution_mode",
        "executed_at"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "skipped",
            "blocked"
          ]
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "automated",
            "manual"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        },
        "error_summary": {
          "oneOf": [
            {
              "$ref": "#/$defs/errorSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
