{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riverscapes.net/schemas/vector_prep/blm_ownership/step-catalog.schema.json",
  "title": "BLM Ownership Step Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "version",
    "steps"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string",
      "const": "blm_ownership"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "order",
        "name",
        "depends_on",
        "mode"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "automated",
            "manual",
            "hybrid"
          ]
        }
      }
    }
  }
}
