      "US_L3CODE": "US_L3CODE",
      "US_L3NAME": "US_L3NAME",
      "NA_L3CODE": "NA_L3CODE",
      "NA_L3NAME": "NA_L3NAME",
      "NA_L2CODE": "NA_L2CODE",
      "NA_L2NAME": "NA_L2NAME",
      "NA_L1CODE": "NA_L1CODE",
      "NA_L1NAME": "NA_L1NAME",
      "L4_KEY": "L4_KEY",
      "L3_KEY": "L3_KEY",
      "L2_KEY": "L2_KEY",
      "L1_KEY": "L1_KEY"
    }
  }
}
