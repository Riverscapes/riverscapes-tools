{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/../../.venv/bin/python",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "/usr/local/lib/python3.12/dist-packages:${env:PYTHONPATH}"
            },
            "args": "${command:pickArgs}"
        },
        {
            "name": "NHDPlusHR: orchestrate --skip-data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/vector_prep/orchestrate-nhdplushr.py",
            "python": "${workspaceFolder}/../../.venv/bin/python",
            "cwd": "${workspaceFolder}/vector_prep",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "/usr/local/lib/python3.12/dist-packages:${env:PYTHONPATH}"
            },
            "stopOnEntry": true,
            "justMyCode": false,
            "args": [
                "--skip-data"
            ]
        },
        {
            "name": "🚀 Run Vector Prep",
            "type": "debugpy",
            "request": "launch",
            "module": "vector_prep.vector_prep",
            "python": "${workspaceFolder}/../../.venv/bin/python",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
            },
            "args": [
                "${input:inputPath}",
                "--output", "${input:outputPath}",
                "--garbage", "${input:garbagePath}",
                "--tolerance", "20",
                "--verbose"
            ]
        }
    ],
    "inputs": [
        {
            "id": "inputPath",
            "type": "promptString",
            "description": "Input vector path (shapefile, gpkg, etc.)",
            "default": "/Volumes/SAMSUNG2TB/Riverscapes/ReportLayers/national_transportation/national_roads.gpkg"
        },
        {
            "id": "outputPath",
            "type": "promptString",
            "description": "Output GeoPackage path",
            "default": "/Volumes/SAMSUNG2TB/Riverscapes/ReportLayers/national_transportation/national_roads_cleaned_OUTPUT.gpkg"
        },
        {
            "id": "garbagePath",
            "type": "promptString",
            "description": "Garbage GeoPackage path (for dropped/changed geometries)",
            "default": "/Volumes/SAMSUNG2TB/Riverscapes/ReportLayers/national_transportation/national_roads_garbage_GARBAGE.gpkg"
        }
    ]
}