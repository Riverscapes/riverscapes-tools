{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${command:python.interpreterPath}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "/usr/local/lib/python3.12/dist-packages:${env:PYTHONPATH}"
            },
            "args": "${command:pickArgs}"
        },
        {
            "name": "Debug Vector Prep (Module)",
            "type": "debugpy",
            "request": "launch",
            "module": "vector_prep",
            "args": "${command:pickArgs}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "NHDPlusHR: orchestrate --skip-data",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/vector_prep/orchestrate-nhdplushr.py",
            "python": "${command:python.interpreterPath}",
            "cwd": "${workspaceFolder}/vector_prep",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "/usr/local/lib/python3.12/dist-packages:${env:PYTHONPATH}"
            },
            "stopOnEntry": true,
            "justMyCode": false,
            "args": [
                "--skip-data"
            ]
        },
        {
            "name": "🗂️ Vector Prep CLI (interactive layer selector)",
            "type": "debugpy",
            "request": "launch",
            "module": "vector_prep.vector_prep_cli",
            "python": "${command:python.interpreterPath}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
            },
            "envFile": "${workspaceFolder}/.env",
            "args": []
        },
    ]
}