{
  "version": "0.2.0",
  "inputs": [
    {
      "type": "promptString",
      "id": "AOI",
      "description": "Path to a GeoJSON defining the area of interest",
      "default": "{env:DATA_ROOT}/aoi/my_area.geojson"
    },
    {
      "type": "promptString",
      "id": "DEM",
      "description": "Path to an already-downloaded DEM raster file",
      "default": "{env:DATA_ROOT}/dems/my_dem.tif"
    }
  ],
  "configurations": [
    {
      "name": "RS Context Neo (--aoi, US CONUS)",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontextneo.rs_context_neo",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/rscontextneo/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "--config", "${workspaceFolder}/config/us_conus.json",
        "--output", "{env:DATA_ROOT}/rs_context_neo/aoi",
        "--verbose",
        "--debug"
      ]
    },
    {
      "name": "RS Context Neo (--dem, US CONUS)",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontextneo.rs_context_neo",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/rscontextneo/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "--config", "${workspaceFolder}/config/us_conus_dem.json",
        "--output", "{env:DATA_ROOT}/rs_context_neo/dem",
        "--verbose",
        "--debug"
      ]
    },
    {
      "name": "RS Context Neo (--aoi, WCS template)",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontextneo.rs_context_neo",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/rscontextneo/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "--config", "${workspaceFolder}/config/global_wcs.json",
        "--aoi", "${input:AOI}",
        "--output", "{env:DATA_ROOT}/rs_context_neo/wcs",
        "--verbose",
        "--debug"
      ]
    }
  ]
}
