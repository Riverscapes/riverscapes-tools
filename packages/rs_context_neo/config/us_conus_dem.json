{
  "$schema": "../config.schema.json",
  "profile_name": "US Contiguous States (CONUS)",
  "description": "Standard RS Context Neo configuration for the contiguous United States and Alaska. Uses USGS 3DEP 1 m DEM tiles via The National Map tile API, with optional transportation layers (roads and rail) from AWS S3 Tables via Athena. Set the required environment variables in your .env file before running.",
  "download_dir": "{env:DOWNLOAD_DIR}",
  "scratch_dir": "{env:SCRATCH_DIR}",

  "dem": {
    "source": "file",
    "filepath": "{env:CUSTOM_DEM_PATH}"
  },

  "hydrology": {
    "threshold": 50000,
    "breach_dist": 100,
    "cores": null
  },

  "layers": [
    {
      "id": "TRANSPORTATION",
      "label": "Transportation",
      "type": "s3tables",
      "output_path": "transportation/transportation.gpkg",
      "athena_output": "{env:ATHENA_OUTPUT}",
      "sublayers": [
        {
          "layer_name": "roads",
          "s3tables_path": "{env:ROADS_S3TABLES_PATH}"
        },
        {
          "layer_name": "rail",
          "s3tables_path": "{env:RAIL_S3TABLES_PATH}"
        }
      ]
    }
  ],

  "metadata": {}
}
