{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "inputs": [
    {
      "type": "promptString",
      "id": "HUC",
      "description": "What HUC?",
      "default": "1601010101"
      // "default": "1005001208" // Really small HUC
      // "default": "17060103" // Asotin
    },
    {
      "type": "promptString",
      "id": "VPU",
      "description": "What VPU?",
      // "default": "17070202" // North Fork John Day
      "default": "1701" // Really small HUC
      // "default": "17060103" // Asotin
    }
  ],  
  "configurations": [
    {
      "name": "RS Context",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.rs_context",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      // Add NATIONAL_PROJECT, INPUTS_FOLDER, DOWNLOAD_FOLDER to your .env file
      "args": [
        "${input:HUC}",
        "{env:NATIONAL_PROJECT}/landfire/240",
        "{env:NATIONAL_PROJECT}/ownership/surface_management_agency.shp",
        "{env:NATIONAL_PROJECT}/ownership/FairMarketValue.tif",
        "{env:NATIONAL_PROJECT}/ecoregions/us_eco_l4_state_boundaries.shp",
        "{env:NATIONAL_PROJECT}/political_boundaries/cb_2021_us_state_500k.shp",
        "{env:NATIONAL_PROJECT}/political_boundaries/cb_2021_us_county_500k.shp",
        "{env:NATIONAL_PROJECT}/geology/SGMC_Geology.shp",
        "{env:NATIONAL_PROJECT}/prism",
        "{env:DATA_ROOT}/national_dams/usace_national_dams.gpkg", 
        "{env:DATA_ROOT}/nhd/nhdplusv2.gpkg",
        "{env:DATA_ROOT}/rs_context/${input:HUC}",
        "{env:DOWNLOAD_FOLDER}",
        "--meta", "Runner=VSCode",
        // "--temp_folder", "{env:DOWNLOAD_FOLDER}/tmp",
        // "--force",
        // "--parallel",
        "--verbose",
        "--debug"
      ]
    },
    {
      "name": "RS Context Metrics",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.rs_context_metrics",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "console": "integratedTerminal",
      "args": [
        "{env:DATA_ROOT}/rs_context/${input:HUC}"
      ]
    },
    {
      "name": "Modis (LST)",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.land_surface_temp",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      // Add NATIONAL_PROJECT, INPUTS_FOLDER, DOWNLOAD_FOLDER to your .env file
      "args": [
        "{env:DATA_ROOT}/MODIS/outputs/${input:VPU}/${input:VPU}.sqlite",
        "{env:DATA_ROOT}/MODIS/MODIS_Mosaic",
        "{env:NHD_ROOT}/NHDPLUS_H_${input:VPU}_HU4_GDB.gdb",
        "--verbose",
        "--debug"
      ]
    },
    // {
    //   "name": "Land Surface Temp XMLS",
    //   "type": "debugpy",
    //   "request": "launch",
    //   "module": "scripts.modis_xmls",
    //   "console": "integratedTerminal",
    //   // Add NATIONAL_PROJECT, INPUTS_FOLDER, DOWNLOAD_FOLDER to your .env file
    //   "args": [
    //     "{env:DATA_ROOT}/MODIS/xmls",
    //     "--verbose",
    //   ]
    // },

    {
      "name": "Write report",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.rs_context_report",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "{env:DATA_ROOT}/rs_context/${input:HUC}/project.rs.xml",
        "{env:DATA_ROOT}/rs_context/${input:HUC}/rsc_report.html"
      ]
    },
    {
      "name": "Download NWI Data",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.download_nwi",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "{env:DATA_ROOT}/nwi_data",
        "nardata",
        "national_wetland_inventory"
      ]
    },
    {
      "name": "Calculate Metrics",
      "type": "debugpy",
      "request": "launch",
      "module": "rscommons.classes.project_metrics",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "{env:DATA_ROOT}/rs_context/${input:HUC}/hydrology/nhdplushr.gpkg",
        "{env:DATA_ROOT}/rs_context/${input:HUC}/project.rs.xml"
      ]
    },
    {
      "name": "Generate Bounding GeoJSON",
      "type": "debugpy",
      "request": "launch",
      "module": "rscommons.project_bounds",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args":[
        "${input:in_layer}",
        "${input:out_layer}",
      ]
    },
    {
      "name": "National Wetlands Inventory",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.national_wetlands_inventory",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args":[
        "${input:HUC}",
        "{env:DATA_ROOT}/download",
        "{env:DATA_ROOT}/rs_context/${input:HUC}/hydrology/nhdplushr.gpkg/wbdhu10",
        "{env:DATA_ROOT}/nwi_data/nwi.gpkg",
      ]
    },
    {
      "name": "Scrape Raster Stats",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.scripts.network_attributes.scrape-raster",
      "console": "integratedTerminal",
      "args": [
        "17", // Comma separated list of HUC2s to process
        "landfire", // Theme used as both folder name and prefix for output files
        "{env:DATA_ROOT}/../nhd/NHDPlus_H_National_Release_2_GDB.gdb",
        "{env:DATA_ROOT}/../landfire/LF2024_FBFM13_CONUS/Tif/LF2024_FBFM13_CONUS.tif",
        "{env:DATA_ROOT}/../network_attributes",
        "--integer", // Leave this off and assumes float rasters, which means it will calculate mean and stddev. With this flag it assumes integer rasters and calculates mode and unique values instead
        "--skip", "-9999"
        // "--verbose",
      ]   ,
         "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
    },
    {
      "name": "Scrape Vector Stats",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.scripts.network_attributes.scrape-vector",
      "console": "integratedTerminal",
      "args": [
        "17", // Comma separated list of HUC2s to process
        "ownership", // Theme used as both folder name and prefix for output files
        "{env:DATA_ROOT}/../nhd/NHDPlus_H_National_Release_2_GDB.gdb",
        "{env:DATA_ROOT}/../surface_management_agency_fixed.gpkg",
        "{env:DATA_ROOT}/../network_attributes",
        "--layer", "ownership",
        "--fields", "sma_code",
        "--verbose",
      ]   ,
         "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
    }
    ,
    {
      "name": "Download Roads",
      "type": "debugpy",
      "request": "launch",
      "module": "rscontext.scripts.download_roads",
      "console": "integratedTerminal",
      "args": [
        "{env:DATA_ROOT}/../roads",
        // "--states", "AL"
      ]   ,
         "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
    },
    {
      "name": "Version Bump",
      "type": "debugpy",
      "module": "rscommons.version",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/../../lib/commons"
      },
      "args": [
        "${workspaceFolder}/rscontext/__version__.py"
      ],
      "request": "launch",
      "console": "integratedTerminal"
    }    
  ]
}