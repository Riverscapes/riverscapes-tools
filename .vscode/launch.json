{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "python": "${command:python.interpreterPath}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/packages/vector_prep${pathSeparator}${workspaceFolder}/lib/commons${pathSeparator}${env:PYTHONPATH}"
      },
      "args": "${command:pickArgs}"
    },
    {
      "name": "Vector Prep: NWI process_nwi.py (module, pick args)",
      "type": "debugpy",
      "request": "launch",
      "module": "vector_prep.layers.us_fws_nwi.process_nwi",
      "python": "${command:python.interpreterPath}",
      "cwd": "${workspaceFolder}/packages/vector_prep",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/packages/vector_prep${pathSeparator}${workspaceFolder}/lib/commons${pathSeparator}${env:PYTHONPATH}"
      },
      "args": "${command:pickArgs}"
    },
    {
      "name": "Vector Prep: NHDPlusHR --skip-data",
      "type": "debugpy",
      "request": "launch",
      "program": "/home/narlorin/ucode/riverscapes-tools/packages/vector_prep/vector_prep/orchestrate-nhdplushr.py",
      "python": "/home/narlorin/ucode/riverscapes-tools/.venv/bin/python",
      "cwd": "/home/narlorin/ucode/riverscapes-tools/packages/vector_prep/vector_prep",
      "console": "integratedTerminal",
      "justMyCode": false,
      "stopOnEntry": true,
      "env": {
        "PYTHONPATH": "/usr/local/lib/python3.12/dist-packages:${env:PYTHONPATH}"
      },
      "args": [
        "--skip-data"
      ]
    },
    {
      "name": "CLI: run module",
      "type": "debugpy",
      "request": "launch",
      "module": "${input:cliModule}",
      "args": [
        "${input:cliArguments}"
      ],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
