{
  "folders": [
    {
      "name": "🚀 RSContext NEO",
      "path": "../packages/rs_context_neo"
    },
    {
      "name": "📦 RSCommons",
      "path": "../lib/commons"
    },
    {
      "name": "🤖 Cybercastor Automation Scripts",
      "path": "../scripts/automation"
    },
    {
      "name": "🧰 Workspaces",
      "path": "."
    },
    {
      "name": "🏠 Git Root",
      "path": ".."
    }
  ],
  "settings": {
    "python.envFile": "${workspaceFolder}/.env",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "[python]": {
      "editor.formatOnSave": true,
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.codeActionsOnSave": {
        "source.fixAll.ruff": "explicit",
        "source.organizeImports.ruff": "explicit"
      }
    },
    "autopep8.args": [
      "--max-line-length=240"
    ],
    "graphql-config.load.rootDir": "${workspaceFolder}",
    "python.analysis.extraPaths": [
      "${workspaceFolder:🏠 Git Root}/lib/commons",
    ],
    "python.terminal.activateEnvironment": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": true,
    "files.watcherExclude": {
      "**/*.egg-info/**": true,
      "**/docs/**": true,
      "**/*.pytest_cache/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "search.exclude": {
      "**/*.egg-info/**": true,
      "**/*.pytest_cache/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "files.exclude": {
      "**/*.egg-info/**": true,
      "**/*.pytest_cache/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true
    },
    "python.defaultInterpreterPath": "${workspaceFolder:🏠 Git Root}/.venv/bin/python",
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
  }
}